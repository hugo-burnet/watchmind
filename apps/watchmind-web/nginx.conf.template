server {
    listen 80;
    server_name _;

    location /api/ {
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header Authorization "Bearer ${WATCHMIND_API_TOKEN}";
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
